# Copy to .env and fill in. Real environment variables always override .env.
# .env is gitignored; never commit secrets.

# Option 1: explicit DeepSeek web token (fastest, no login at startup).
# From chat.deepseek.com DevTools -> Local Storage -> userToken -> value,
# or: python -m dsk.auth you@example.com yourpassword
DEEPSEEK_AUTH_TOKEN=

# Option 2: credential auto-login (used when DEEPSEEK_AUTH_TOKEN is unset).
# The server logs in once via browser and caches the token; see below.
DEEPSEEK_EMAIL=
DEEPSEEK_PASSWORD=

# Where the auto-login token is cached (default ~/.deepseek_token).
DEEPSEEK_TOKEN_FILE=

# Client key required by harnesses (Authorization: Bearer ...).
# Unset = any key accepted (localhost only by default).
OPENAI_API_KEY=

# Server bind (defaults 127.0.0.1:8080).
HOST=127.0.0.1
PORT=8080

# Set to 1 to log prompts and raw replies to stderr for debugging.
OPENAI_DEBUG=
